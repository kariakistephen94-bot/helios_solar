ENVIRONMENT=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Legacy anon key or a modern sb_publishable_ key.
SUPABASE_ANON_KEY=
# Modern sb_secret_ key or legacy service_role JWT. Backend only.
SUPABASE_SECRET_KEY=
GOOGLE_PLACES_API_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=
CORS_ORIGINS=["http://127.0.0.1:3002","http://localhost:3002"]
SCAN_INTERVAL_HOURS=24
DAILY_REQUEST_LIMIT=100
REQUEST_SPACING_SECONDS=2
MAX_PAGES=3
DAILY_NEW_TARGET=20
MIN_RATING=4.0
MIN_REVIEW_COUNT=10
REVISIT_HOURS=168

# Website Sol chat only. Keep this key server-side.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# n8n outreach receiver; keep the matching Header Auth value server-only.
N8N_OUTREACH_WEBHOOK_URL=
N8N_OUTREACH_WEBHOOK_SECRET=

# Automatic fixed-template queue; requires migration 008. Does not send.
OUTREACH_AUTOMATIC_ENABLED=false

# Only the two authorized Stephen numbers; real inbound window required.
OUTREACH_TEST_DELIVERY_ENABLED=false

# Local linked-device gateway. Never use NEXT_PUBLIC_ for this key.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3000
WHATSAPP_GATEWAY_API_KEY=

# Allowlisted Stephen tests only; requires gateway-test migration.
GATEWAY_TEST_DELIVERY_ENABLED=false

# Must match the gateway STATUS_WEBHOOK_SECRET. Separate from send/webhook keys.
GATEWAY_STATUS_WEBHOOK_SECRET=
